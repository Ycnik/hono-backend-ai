meta {
  name: Ersetzen
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/soldaten/{{id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  If-Match: {{etag}}
}

body:json {
  {
    "vorname": "Bruno",
    "nachname": "Abnahme",
    "username": "{{testUsername}}",
    "geburtsdatum": "2001-04-20",
    "geschlecht": "MAENNLICH",
    "rang": "REKRUT",
    "ausruestung": {
      "waffe": "ODM_GEAR",
      "seriennummer": "AOT-{{testSerial}}"
    },
    "verletzungen": []
  }
}

script:post-response {
  bru.setVar("etag", res.getHeader("etag"));
}

assert {
  res.status: eq 204
}
