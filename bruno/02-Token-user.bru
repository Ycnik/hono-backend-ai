meta {
  name: Token-user
  type: http
  seq: 2
}

post {
  url: {{issuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: javascript-client
  client_secret: {{clientSecret}}
  username: user
  password: {{testPassword}}
}

script:post-response {
  bru.setVar("userToken", res.getBody().access_token);
}

assert {
  res.status: eq 200
}
