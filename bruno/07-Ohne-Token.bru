meta {
  name: Ohne-Token
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/soldaten/{{id}}
  body: json
  auth: none
}

headers {
  If-Match: {{etag}}
}

body:json {
  {
    "vorname": "Bruno",
    "nachname": "Abnahme",
    "username": "{{testUsername}}",
    "geburtsdatum": "2001-04-20",
    "geschlecht": "MAENNLICH",
    "rang": "REKRUT",
    "ausruestung": {
      "waffe": "ODM_GEAR",
      "seriennummer": "AOT-{{testSerial}}"
    },
    "verletzungen": []
  }
}

assert {
  res.status: eq 401
}
